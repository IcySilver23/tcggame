{
  "name": "tcg-life",
  "private": true,
  "version": "0.7.1",
  "description": "TCG Life — a collector-life simulator built on the real Pokémon TCG. Real card data from pokemontcg.io, real TCGplayer USD market prices, official card imagery.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "sync": "tsx server/scripts/sync-cli.ts",
    "build:installer": "bash scripts/build-installer.sh",
    "sim:rival": "tsx server/scripts/rival-sim.ts",
    "sim:franchise": "tsx server/scripts/franchise-sim.ts",
    "sim:resale": "tsx server/scripts/resale-sim.ts",
    "sim:resale-probe": "tsx server/scripts/resale-probe.ts",
    "sim:empire": "tsx server/scripts/empire-sim.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^11.5.0",
    "hono": "^4.6.10",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit-cli": "^3.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
